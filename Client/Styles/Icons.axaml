<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Simple monochrome line-icon geometries (flat outline style) rather than colorful emoji. -->
    <Geometry x:Key="FolderIconGeometry">M1,3 L5,3 L6.3,4.5 L13,4.5 L13,15 L1,15 Z</Geometry>
    <!-- FolderIconGeometry's shape (shrunk to leave room for the badge) plus a small "+". -->
    <Geometry x:Key="NewFolderIconGeometry">M1,3 L5,3 L6.3,4.5 L11,4.5 L11,11 L1,11 Z M9,9 L9,13 M7,11 L11,11</Geometry>
    <Geometry x:Key="HomeIconGeometry">M3,9 L12,2 L21,9 L21,20 A2,2 0 0,1 19,22 L5,22 A2,2 0 0,1 3,20 Z M9,22 L9,12 L15,12 L15,22</Geometry>
    <!-- The two bare M points (no drawn segment) pin the bounding box to the same 1,1-13,13 square the other
         window-control icons use, so Stretch="Uniform" scales this one identically instead of over-zooming a
         thin bar's own tiny bounding box. -->
    <Geometry x:Key="MinimizeIconGeometry">M1,1 M13,13 M1,10.6 L13,10.6 L13,12 L1,12 Z</Geometry>
    <Geometry x:Key="MaximizeIconGeometry">M1,1 L13,1 L13,13 L1,13 Z</Geometry>
    <Geometry x:Key="RestoreIconGeometry">M4,1 L13,1 L13,10 L10,10 M1,4 L10,4 L10,13 L1,13 Z</Geometry>
    <Geometry x:Key="CloseIconGeometry">M1,1 L13,13 M13,1 L1,13</Geometry>
    <Geometry x:Key="ChevronDownIconGeometry">M2,4 L7,9 L12,4</Geometry>
    <!-- A page outline with text lines, for a text asset node. -->
    <Geometry x:Key="TextIconGeometry">M2,1 L9,1 L13,5 L13,15 L2,15 Z M9,1 L9,5 L13,5 M4.5,8 L10.5,8 M4.5,10.5 L10.5,10.5 M4.5,13 L8,13</Geometry>
    <!-- A picture frame with a mountain/sun motif, for an image asset node. -->
    <Geometry x:Key="ImageIconGeometry">M1,2 L15,2 L15,14 L1,14 Z M1,11 L5.5,6.5 L9,10 L11,8 L15,12 M11,5.5 A0.75,0.75 0 1 1 11,5.49</Geometry>
    <!-- An isometric cube, for a mesh asset node. -->
    <Geometry x:Key="MeshIconGeometry">M8,1 L15,4.5 L15,11.5 L8,15 L1,11.5 L1,4.5 Z M1,4.5 L8,8 L15,4.5 M8,8 L8,15</Geometry>
    <!-- A gear, for the options/settings dialog. -->
    <Geometry x:Key="GearIconGeometry">M8,5.2 A2.8,2.8 0 1 1 8,10.8 A2.8,2.8 0 1 1 8,5.2 Z M8,1 L8,2.6 M8,13.4 L8,15 M1,8 L2.6,8 M13.4,8 L15,8 M3.05,3.05 L4.17,4.17 M11.83,11.83 L12.95,12.95 M12.95,3.05 L11.83,4.17 M4.17,11.83 L3.05,12.95</Geometry>
    <!-- A link/chain, for cross-hierarchy node links. -->
    <Geometry x:Key="LinkIconGeometry">M6.5,9.5 L9.5,6.5 M6,4.5 L7,3.5 A2.6,2.6 0 1 1 10.5,7 L9.5,8 M10,11.5 L9,12.5 A2.6,2.6 0 1 1 5.5,9 L6.5,8</Geometry>
</ResourceDictionary>
