<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Markwardt.AssetPipeline.Client.ViewModels.Dialogs"
        x:Class="Markwardt.AssetPipeline.Client.Views.Dialogs.ConfirmDialogWindow"
        x:DataType="vm:ConfirmDialogViewModel"
        Width="420" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner"
        Title="{Binding Title}"
        Background="{DynamicResource EditorBackgroundBrush}">
    <StackPanel Margin="16" Spacing="14">
        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="{Binding CancelText}" Command="{Binding CancelCommand}" />
            <Button Content="{Binding ConfirmText}" Classes="accent" Command="{Binding ConfirmCommand}" />
        </StackPanel>
    </StackPanel>
</Window>
