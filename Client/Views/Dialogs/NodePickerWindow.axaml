<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Markwardt.AssetPipeline.Client.ViewModels.Dialogs"
        xmlns:nodes="using:Markwardt.AssetPipeline.Client.ViewModels"
        xmlns:infra="using:Markwardt.AssetPipeline.Client.Infrastructure"
        x:Class="Markwardt.AssetPipeline.Client.Views.Dialogs.NodePickerWindow"
        x:DataType="vm:NodePickerViewModel"
        Width="360" Height="420"
        WindowStartupLocation="CenterOwner"
        Title="{Binding Title}"
        Background="{DynamicResource EditorBackgroundBrush}">
    <Window.Resources>
        <infra:ProjectNodeIconConverter x:Key="ProjectNodeIconConverter" />
    </Window.Resources>
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,14,0,0">
            <Button Content="Cancel" Command="{Binding CancelCommand}" />
            <Button Content="Link" Classes="accent" Command="{Binding ConfirmCommand}" />
        </StackPanel>
        <TextBlock DockPanel.Dock="Top" Text="No linkable nodes available." Margin="0,0,0,8"
                   Foreground="{DynamicResource TextMutedBrush}" IsVisible="{Binding !Candidates.Count}" />
        <ListBox ItemsSource="{Binding Candidates}" SelectedItem="{Binding Selected, Mode=TwoWay}">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="nodes:ProjectNodeViewModel">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Path Classes="lineIcon" Data="{Binding Converter={StaticResource ProjectNodeIconConverter}}" Width="12" Height="12" />
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
